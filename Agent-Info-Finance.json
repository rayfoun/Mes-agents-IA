    {
      "parameters": {
        "jsCode": "// ═══════════════════════════════════════════════════════════\n//  EXTRACTEUR DE CONCEPTS → transforme la réponse de l'IA\n//  (du texte) en données rangeables dans la Data Table\n// ═══════════════════════════════════════════════════════════\n\n// 1) On récupère la réponse de l'IA (le champ \"text\" du nœud précédent)\n//    et on enlève les espaces vides au début et à la fin.\nlet raw = $input.first().json.text.trim();\n\n// 2) Les IA entourent parfois leur JSON de balises ```json ... ```\n//    On les supprime pour ne garder que le JSON pur, sinon la\n//    conversion de l'étape suivante planterait.\nraw = raw.replace(/```json/g, '').replace(/```/g, '').trim();\n\n// 3) On prépare une liste vide qui accueillera les concepts.\nlet concepts = [];\n\n// 4) On tente de convertir le texte en vraies données (JSON.parse).\n//    C'est l'étape clé : texte → données exploitables.\ntry {\n  concepts = JSON.parse(raw);\n} catch (e) {\n  // Filet de sécurité : si l'IA a mal formaté sa réponse,\n  // on renvoie une liste vide au lieu de faire planter tout le workflow.\n  return [];\n}\n\n// 5) n8n exige que chaque donnée soit emballée dans { json: ... }.\n//    On parcourt chaque concept et on l'emballe à ce format.\n//    Résultat : 1 concept = 1 item = 1 future ligne dans la base.\nreturn concepts.map(c => ({ json: c }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
